# GitHub OAuth App (Settings > Developer settings > OAuth Apps). Enable "Device Flow".
GITHUB_CLIENT_ID=
# Fernet key for encrypting secret values at rest:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
SM_ENCRYPTION_KEY=
DATABASE_URL=sqlite:///./secrets.db
# GitHub login of the first admin (used by seed.py)
SEED_ADMIN_GITHUB_LOGIN=
SEED_ORG_NAME=Acme
