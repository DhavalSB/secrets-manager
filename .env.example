# GitHub OAuth App (Settings > Developer settings > OAuth Apps > New OAuth App)
#   Homepage URL:  http://localhost:8000
#   Callback URL:  http://localhost:8000/auth/callback
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
# Fernet key for encrypting secret values at rest:
#   ./.venv/bin/python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
SM_ENCRYPTION_KEY=
# Relative to server/, where you run uvicorn
DATABASE_URL=sqlite:///./secrets.db
# GitHub login of the first admin (used by `python -m app.seed`)
SEED_ADMIN_GITHUB_LOGIN=
SEED_ORG_NAME=Acme
# Set to 1 to allow `sm login --dev <user>` (log in as seeded demo users without GitHub)
SM_DEV_LOGIN=0
